// Reloj y LEDs: pines verificados en el resumen del proyecto (confirma la polaridad con tu placa)


IO_LOC "led_n[0]" 38;
IO_LOC "led_n[1]" 37;
IO_LOC "led_n[2]" 36;
IO_LOC "led_n[3]" 39;
IO_LOC "led_n[4]" 25;
IO_LOC "led_n[5]" 26;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// ---- Pines de la tira (53 a 57): usados como GPIO en proyectos publicos para la Tang Nano 9K ----
// Confirma en el pinout de Sipeed que esos pines estan en tu tira antes de cablear.
// Nuevos pines libres en Tang Nano 9K:
IO_LOC "scki"    27;   // FPGA -> pin SCKI/MCLK del módulo PCM1808
IO_LOC "bck"     30;   // FPGA -> pin BCK
IO_LOC "lrck"    28;   // FPGA -> pin LRCK / LRC
IO_LOC "dout"    29;   // módulo -> FPGA (pin DOUT / OUT)
IO_LOC  "pwm_out" 41;

IO_PORT "scki"    IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "bck"     IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lrck"    IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dout"    IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "pwm_out" IO_TYPE=LVCMOS33 DRIVE=8;



// =====================================================================
//  Pines Tang Nano 9K - EchoSpectrum avance
//  El numero de cada pin esta impreso en la placa, al lado de cada pata.
//  Todos los pines externos usados aqui son de 3,3 V.
//  (LEDs y botones de la placa estan en el banco de 1,8 V -> LVCMOS18)
// =====================================================================

// Reloj de 27 MHz de la placa
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Botones de la placa (0 = oprimido)
IO_LOC  "btn_a_n" 3;
IO_PORT "btn_a_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "btn_b_n" 4;
IO_PORT "btn_b_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;



// ---------------- Matriz MAX7219 (a traves del 74HC125) ----------------
IO_LOC  "mat_din" 33;
IO_PORT "mat_din" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "mat_clk" 34;
IO_PORT "mat_clk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "mat_cs"  40;
IO_PORT "mat_cs"  IO_TYPE=LVCMOS33 DRIVE=8;


IO_LOC "mcp_cs_n" 48;  IO_PORT "mcp_cs_n" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "mcp_clk"  32;  IO_PORT "mcp_clk"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "mcp_din"  49;  IO_PORT "mcp_din"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "mcp_dout" 31;  IO_PORT "mcp_dout" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;